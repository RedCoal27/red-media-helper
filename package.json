{
  "name": "red-media-helper",
  "version": "1.5.2",
  "description": "Media controls and cross-platform download helpers for browsers, Windows, and Android.",
  "license": "MIT",
  "scripts": {
    "build": "node utils/build.js",
    "start": "node utils/build.js --watch",
    "install:ytdlp": "node utils/install-ytdlp.js",
    "install:ffmpeg": "node utils/install-ffmpeg.js",
    "install:aria2": "node utils/install-aria2.js",
    "ytdlp-server": "node utils/ytdlp-server.js",
    "build:helper": "powershell -ExecutionPolicy Bypass -File utils/build-helper-exe.ps1",
    "package:release": "powershell -ExecutionPolicy Bypass -File utils/package-release.ps1",
    "test": "node --test tests/*.test.js",
    "prettier": "prettier --write '**/*.{js,jsx,css,html}'"
  },
  "dependencies": {
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@types/chrome": "0.0.126",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "esbuild": "^0.28.1",
    "prettier": "^2.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  }
}
